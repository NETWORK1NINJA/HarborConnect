@model HarborConnect.Models.Boat

@{
    ViewBag.Title = "Add Your Boat";
}

<div class="container mt-5 mb-5">

    <!-- PAGE HEADER -->
    <div class="text-center mb-5">

        <span style="
            color:#0088b8;
            font-weight:700;
            letter-spacing:2px;
        ">
            HARBOR CONNECT
        </span>

        <h1 style="
            color:#003b5c;
            font-weight:700;
            margin-top:10px;
        ">
            Add Your Boat
        </h1>

        <p style="
            color:#687982;
            font-size:17px;
        ">
            List your boat and start earning from your vessel.
        </p>

    </div>


    <!-- FORM CONTAINER -->
    <div class="row justify-content-center">

        <div class="col-md-8">

            <div style="
                background:white;
                padding:40px;
                border-radius:20px;
                box-shadow:0 10px 30px rgba(0,59,92,0.12);
                border:1px solid #e6f0f4;
            ">

                @using (Html.BeginForm("Create", "Boat", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()


                    <!-- VALIDATION SUMMARY -->

                    @Html.ValidationSummary(
                        false,
                        "Please correct the following errors:",
                        new { @class = "alert alert-danger" }
                    )


                    <!-- BOAT NAME -->

                    <div class="form-group mb-3">

                        @Html.LabelFor(
                            model => model.BoatName,
                            new { @class = "font-weight-bold" }
                        )

                        @Html.TextBoxFor(
                            model => model.BoatName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter boat name"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.BoatName,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- CATEGORY -->

                    <div class="form-group mb-3">

                        @Html.LabelFor(
                            model => model.CategoryId,
                            new { @class = "font-weight-bold" }
                        )

                        @Html.DropDownList(
                            "CategoryId",
                            null,
                            "-- Select Boat Category --",
                            new { @class = "form-control" }
                        )

                        @Html.ValidationMessageFor(
                            model => model.CategoryId,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="form-group mb-3">

                        @Html.LabelFor(
                            model => model.Description,
                            new { @class = "font-weight-bold" }
                        )

                        @Html.TextAreaFor(
                            model => model.Description,
                            new
                            {
                                @class = "form-control",
                                rows = "4",
                                placeholder = "Describe your boat..."
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Description,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- CAPACITY AND PRICE -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group mb-3">

                                @Html.LabelFor(
                                    model => model.Capacity,
                                    new { @class = "font-weight-bold" }
                                )

                                @Html.TextBoxFor(
                                    model => model.Capacity,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        min = "1",
                                        placeholder = "Number of passengers"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.Capacity,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-group mb-3">

                                @Html.LabelFor(
                                    model => model.PricePerTrip,
                                    new { @class = "font-weight-bold" }
                                )

                                @Html.TextBoxFor(
                                    model => model.PricePerTrip,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        step = "0.01",
                                        min = "0",
                                        placeholder = "Price per trip"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.PricePerTrip,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>

                        </div>

                    </div>


                    <!-- LOCATION -->

                    <div class="form-group mb-4">

                        @Html.LabelFor(
                            model => model.Location,
                            new { @class = "font-weight-bold" }
                        )

                        @Html.TextBoxFor(
                            model => model.Location,
                            new
                            {
                                @class = "form-control",
                                placeholder = "e.g. Durban Harbour"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Location,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- APPROVAL INFORMATION -->

                    <div class="alert alert-info">

                        <strong>Approval Process</strong>

                        <p class="mb-0 mt-2">

                            Your boat will be submitted for Admin approval.
                            It will only become available for customers to book
                            after it has been approved.

                        </p>

                    </div>


                    <!-- SUBMIT BUTTON -->

                    <button type="submit"
                            class="btn btn-lg"
                            style="
                                width:100%;
                                background:#0088b8;
                                color:white;
                                border:none;
                                border-radius:25px;
                                padding:12px;
                                font-weight:600;
                            ">

                        Submit Boat for Approval

                    </button>

                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}
@model IEnumerable<HarborConnect.Models.Booking>

@{
    ViewBag.Title = "My Bookings";
}

<div class="container mt-5 mb-5">

    <!-- PAGE HEADER -->

    <div class="text-center mb-5">

        <span style="
            color:#0088b8;
            font-weight:700;
            letter-spacing:2px;
        ">
            HARBOR CONNECT
        </span>

        <h1 style="
            color:#003b5c;
            font-weight:700;
            margin-top:10px;
        ">
            My Bookings
        </h1>

        <p style="
            color:#687982;
            font-size:17px;
        ">
            View and manage your boat bookings.
        </p>

    </div>


    @if (Model == null || !Model.Any())
    {
        <!-- NO BOOKINGS -->

        <div class="text-center">

            <div style="
                background:white;
                border-radius:20px;
                padding:50px 30px;
                box-shadow:0 10px 30px rgba(0,59,92,0.10);
                border:1px solid #e6f0f4;
            ">

                <div style="
                    width:90px;
                    height:90px;
                    margin:0 auto 20px;
                    border-radius:50%;
                    background:#e6f7fc;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:42px;
                ">
                    🚤
                </div>

                <h2 style="
                    color:#003b5c;
                    font-weight:700;
                ">
                    No Bookings Yet
                </h2>

                <p style="
                    color:#687982;
                    margin-bottom:25px;
                ">
                    You haven't made any boat bookings yet.
                </p>

                <a href="@Url.Action("Index", "Home")"
                   class="btn"
                   style="
                       background:#0088b8;
                       color:white;
                       border:none;
                       border-radius:25px;
                       padding:11px 28px;
                       font-weight:600;
                   ">
                    Find a Boat
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- BOOKINGS -->

        foreach (var booking in Model)
        {
            <div style="
                background:white;
                border-radius:20px;
                padding:30px;
                margin-bottom:25px;
                box-shadow:0 10px 30px rgba(0,59,92,0.10);
                border:1px solid #e6f0f4;
            ">

                <div class="row align-items-center">

                    <!-- BOAT -->

                    <div class="col-md-3 text-center mb-3">

                        <div style="
                            width:75px;
                            height:75px;
                            margin:0 auto 12px;
                            border-radius:50%;
                            background:#e6f7fc;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            font-size:35px;
                        ">
                            🚤
                        </div>

                        <h4 style="
                            color:#003b5c;
                            font-weight:700;
                        ">
                            @booking.Boat.BoatName
                        </h4>

                        <small style="color:#687982;">
                            @booking.Category.CategoryName Boat
                        </small>

                    </div>


                    <!-- BOOKING DETAILS -->

                    <div class="col-md-6 mb-3">

                        <div class="row">

                            <div class="col-sm-6 mb-3">

                                <strong style="color:#003b5c;">
                                    Booking Reference
                                </strong>

                                <div style="color:#687982;">
                                    HC-@booking.BookingId.ToString("D5")
                                </div>

                            </div>


                            <div class="col-sm-6 mb-3">

                                <strong style="color:#003b5c;">
                                    Trip Date
                                </strong>

                                <div style="color:#687982;">
                                    @booking.TripDate.ToString("dd MMM yyyy")
                                </div>

                            </div>


                            <div class="col-sm-6 mb-3">

                                <strong style="color:#003b5c;">
                                    Time
                                </strong>

                                <div style="color:#687982;">
                                    @booking.StartTime.ToString(@"hh\:mm")
                                    -
                                    @booking.EndTime.ToString(@"hh\:mm")
                                </div>

                            </div>


                            <div class="col-sm-6 mb-3">

                                <strong style="color:#003b5c;">
                                    Passengers
                                </strong>

                                <div style="color:#687982;">
                                    @booking.NumberOfPassengers
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- STATUS + PRICE -->

                    <div class="col-md-3 text-center">

                        <div style="
                            color:#0088b8;
                            font-size:24px;
                            font-weight:700;
                            margin-bottom:10px;
                        ">
                            R @booking.TotalAmount.ToString("N2")
                        </div>


                        @if (booking.BookingStatus == "Pending")
                        {
                            <span style="
                                display:inline-block;
                                background:#fff3cd;
                                color:#856404;
                                padding:6px 15px;
                                border-radius:20px;
                                font-weight:600;
                                margin-bottom:7px;
                            ">
                                Pending
                            </span>
                        }
                        else if (booking.BookingStatus == "Confirmed")
                        {
                            <span style="
                                display:inline-block;
                                background:#d4edda;
                                color:#155724;
                                padding:6px 15px;
                                border-radius:20px;
                                font-weight:600;
                                margin-bottom:7px;
                            ">
                                Confirmed
                            </span>
                        }
                        else if (booking.BookingStatus == "Cancelled")
                        {
                            <span style="
                                display:inline-block;
                                background:#f8d7da;
                                color:#721c24;
                                padding:6px 15px;
                                border-radius:20px;
                                font-weight:600;
                                margin-bottom:7px;
                            ">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span style="
                                display:inline-block;
                                background:#e2e3e5;
                                color:#383d41;
                                padding:6px 15px;
                                border-radius:20px;
                                font-weight:600;
                                margin-bottom:7px;
                            ">
                                @booking.BookingStatus
                            </span>
                        }


                        <br />


                        @if (booking.PaymentStatus == "Unpaid")
                        {
                            <span style="
                                display:inline-block;
                                background:#f8d7da;
                                color:#721c24;
                                padding:5px 13px;
                                border-radius:20px;
                                font-size:13px;
                                font-weight:600;
                                margin-bottom:12px;
                            ">
                                Unpaid
                            </span>
                        }
                        else
                        {
                            <span style="
                                display:inline-block;
                                background:#d4edda;
                                color:#155724;
                                padding:5px 13px;
                                border-radius:20px;
                                font-size:13px;
                                font-weight:600;
                                margin-bottom:12px;
                            ">
                                @booking.PaymentStatus
                            </span>
                        }


                        <br />


                        <a href="@Url.Action("Details", "Booking", new { id = booking.BookingId })"
                           class="btn"
                           style="
                               background:#003b5c;
                               color:white;
                               border:none;
                               border-radius:20px;
                               padding:8px 20px;
                               font-weight:600;
                           ">
                            View Details
                        </a>

                    </div>

                </div>

            </div>
        }
    }

</div>
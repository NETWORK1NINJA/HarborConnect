@model HarborConnect.Models.BoatCategory

@{
    ViewBag.Title = "Book a Boat";
}

<div class="text-center mb-5">
    <span style="color:#0088b8; font-weight:700; letter-spacing:2px;">
        HARBOR CONNECT
    </span>

    <h1 style="color:#003b5c; font-weight:700;">
        Book Your Boat
    </h1>

    <p style="color:#687982;">
        Select your trip details below.
    </p>
</div>

<div class="row justify-content-center">

    <div class="col-md-8">

        <div style="
            background:white;
            padding:40px;
            border-radius:20px;
            box-shadow:0 10px 30px rgba(0,59,92,0.12);
            border:1px solid #e6f0f4;
        ">

            <div class="text-center mb-4">

                <div style="
                    width:80px;
                    height:80px;
                    margin:0 auto 20px;
                    border-radius:50%;
                    background:#e6f7fc;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:38px;
                ">
                    🚤
                </div>

                <h2 style="color:#003b5c;">
                    @Model.CategoryName Boat
                </h2>

                <p style="color:#687982;">
                    @Model.Description
                </p>

                <h3 style="color:#0088b8;">
                    R @Model.Price.ToString("N2")
                </h3>

                <small style="color:#7b8b92;">
                    Starting price per trip
                </small>

            </div>

            <hr />

            @using (Html.BeginForm("Create", "Booking", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="categoryId"
                       value="@Model.CategoryId" />

                <div class="alert alert-info">
                    <strong>Selected Boat Category:</strong>
                    @Model.CategoryName
                </div>

                <div class="form-group">
                    <label>Select Your Boat</label>

                    @if (ViewBag.AvailableBoats != null &&
                         ViewBag.AvailableBoats.Count > 0)
                    {
                        <select name="BoatId"
                                class="form-control"
                                required>

                            <option value="">-- Select a Boat --</option>

                            @foreach (var boat in ViewBag.AvailableBoats)
                            {
                                <option value="@boat.BoatId">
                                    @boat.BoatName - Capacity: @boat.Capacity - R @boat.PricePerTrip.ToString("N2")
                                </option>
                            }

                        </select>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <strong>No boats available.</strong>
                            There are currently no approved boats available in this category.
                        </div>
                    }
                </div>

                <br />

                <div class="form-group">
                    <label>Trip Date</label>

                    <input type="date"
                           class="form-control"
                           name="TripDate"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">

                            <label>Start Time</label>

                            <input type="time"
                                   class="form-control"
                                   name="StartTime"
                                   required />

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">

                            <label>End Time</label>

                            <input type="time"
                                   class="form-control"
                                   name="EndTime"
                                   required />

                        </div>
                    </div>

                </div>

                <br />

                <div class="form-group">

                    <label>Number of Passengers</label>

                    <input type="number"
                           class="form-control"
                           name="NumberOfPassengers"
                           min="1"
                           max="100"
                           value="1"
                           required />

                </div>

                <br />

                <div class="form-group">

                    <label>Special Request <small>(Optional)</small></label>

                    <textarea name="SpecialRequest"
                              class="form-control"
                              rows="4"
                              maxlength="500"
                              placeholder="Enter any special requests here..."></textarea>

                </div>

                <br />

                if (ViewBag.AvailableBoats != null &&
                     ViewBag.AvailableBoats.Count > 0)
                {
                    <button type="submit"
                            class="btn btn-primary btn-lg"
                            style="
                                width:100%;
                                background:#0088b8;
                                border:none;
                                border-radius:25px;
                                padding:12px;
                                font-weight:600;
                            ">
                        Continue Booking
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary btn-lg"
                            disabled
                            style="
                                width:100%;
                                border-radius:25px;
                                padding:12px;
                            ">
                        No Boats Currently Available
                    </button>
                }
            }

        </div>

    </div>

</div>